        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nautonumber\n\ncontrol BookingController\ncontrol SystemValidationService as ValService\nentity \&quot;Maintenance (Entity)\&quot; as Maintenance\nentity \&quot;Booking (Entity)\&quot; as Booking\nentity \&quot;Operator (Entity)\&quot; as Operator\n\nBookingController -&gt; ValService: 1. validateAll(machineId, operatorId, start, end)\nValService -&gt; Maintenance: 2. checkMaintenanceOverlap(machineId, start, end)\nMaintenance --&gt; ValService: 3. isMaintenanceOverlap\nalt #LightPink Máy bị dính lịch bảo trì\n    ValService --&gt; BookingController: 4. Return Invalid(\&quot;Máy đang trong thời gian bảo trì!\&quot;)\nelse #LightGreen Máy không dính bảo trì\n    ValService -&gt; Booking: 5. checkBookingOverlap(machineId, start, end)\n    Booking --&gt; ValService: 6. isBookingOverlap\n    alt #LightPink Máy bị trùng đơn đặt khác\n        ValService --&gt; BookingController: 7. Return Invalid(\&quot;Máy đã có đơn đặt trùng giờ!\&quot;)\n    else #LightGreen Máy trống lịch\n        opt Có chọn Tài xế\n            ValService -&gt; Operator: 8. checkEligibilityAndSchedule(operatorId, start, end)\n            Operator --&gt; ValService: 9. is_eligible &amp; isOperatorOverlap\n            alt #LightPink Tài xế chưa duyệt (is_eligible = FALSE) hoặc bận đơn khác\n                ValService --&gt; BookingController: 10. Return Invalid(\&quot;Tài xế chưa đủ điều kiện / Bận!\&quot;)\n            end\n        end\n        ValService --&gt; BookingController: 11. Return Valid(\&quot;Hợp lệ hoàn toàn\&quot;)\n    end\nend\n@endl&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yirKASJskIncktbe-xHL-293">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=13;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
