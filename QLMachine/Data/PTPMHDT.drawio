        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nautonumber\n\nactor Farmer\nboundary BookingUI\ncontrol BookingController\ncontrol SystemValidationService as ValService\nentity \&quot;Machine (Entity)\&quot; as Machine\nentity \&quot;Operator (Entity)\&quot; as Operator\nentity \&quot;Booking (Entity)\&quot; as Booking\n\nFarmer -&gt; BookingUI: 1. Mở Form BM-01 (Chọn thời gian, chọn Tài xế)\nFarmer -&gt; BookingUI: 2. Bấm \&quot;Xác nhận đặt máy\&quot;\nBookingUI -&gt; BookingController: 3. createBooking(farmerId, machineId, operatorId, start, end)\nBookingController -&gt; ValService: 4. validateAllConstraints(machineId, operatorId, start, end)\nalt #LightPink Vi phạm điều kiện chặn (Trùng lịch bảo trì / Xế is_eligible = FALSE)\n    ValService --&gt; BookingController: 5. ValidationResult(Valid = False, ErrorMessage)\n    BookingController --&gt; BookingUI: 6. Exception(ErrorMessage)\n    BookingUI --&gt; Farmer: 7. Hiển thị thông báo lỗi chặn\nelse #LightGreen Tất cả điều kiện Hợp lệ\n    ValService --&gt; BookingController: 8. ValidationResult(Valid = True)\n    BookingController -&gt; Machine: 9. getHourlyRate(machineId)\n    Machine --&gt; BookingController: 10. machineRate\n    opt Có thuê thêm Tài xế\n        BookingController -&gt; Operator: 11. getHourlyRate(operatorId)\n        Operator --&gt; BookingController: 12. operatorRate\n    end\n    BookingController -&gt; BookingController: 13. calculateTotalFee(hours, machineRate, operatorRate)\n    BookingController -&gt; Booking: 14. saveBookingRecord(status = &#39;PENDING&#39;)\n    Booking --&gt; BookingController: 15. newBookingId\n    BookingController --&gt; BookingUI: 16. Return BookingSuccess\n    BookingUI --&gt; Farmer: 17. Thông báo \&quot;Tạo đơn thành công, chờ Chủ máy duyệt\&quot;\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yirKASJskIncktbe-xHL-67">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=13;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
