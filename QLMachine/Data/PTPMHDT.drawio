        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam shadowing false\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam componentStyle uml2\n\npackage \&quot;Presentation Layer (Frontend)\&quot; #E8F5E9 {\n    [Web UI (HTML5 / Bootstrap 5 / JS)] as WebUI\n}\n\npackage \&quot;Business Logic Layer (Spring Boot)\&quot; #E3F2FD {\n    package \&quot;Controllers\&quot; #FFFFFF {\n        [AuthController]\n        [BookingController]\n        [MachineController]\n        [OperatorController]\n    }\n\n    package \&quot;Services\&quot; #FFFFFF {\n        [BookingService]\n        [SystemValidationService]\n    }\n}\n\npackage \&quot;Data Access Layer\&quot; #FFF8E1 {\n    package \&quot;Repositories (Spring Data JPA)\&quot; #FFFFFF {\n        [UserRepository]\n        [BookingRepository]\n        [MachineRepository]\n        [MaintenanceRepository]\n        [OperatorRepository]\n    }\n    database \&quot;Microsoft SQL Server\&quot; as SQLServer #FFFFFF\n}\n\nWebUI ..&gt; [AuthController] : &lt;&lt;REST API&gt;&gt;\nWebUI ..&gt; [BookingController] : &lt;&lt;REST API&gt;&gt;\nWebUI ..&gt; [MachineController] : &lt;&lt;REST API&gt;&gt;\nWebUI ..&gt; [OperatorController] : &lt;&lt;REST API&gt;&gt;\n\n[AuthController] ..&gt; [UserRepository] : &lt;&lt;use&gt;&gt;\n[BookingController] ..&gt; [BookingService] : &lt;&lt;use&gt;&gt;\n[MachineController] ..&gt; [MachineRepository] : &lt;&lt;use&gt;&gt;\n[OperatorController] ..&gt; [OperatorRepository] : &lt;&lt;use&gt;&gt;\n\n[BookingService] ..&gt; [SystemValidationService] : &lt;&lt;validate&gt;&gt;\n[BookingService] ..&gt; [BookingRepository] : &lt;&lt;use&gt;&gt;\n[SystemValidationService] ..&gt; [MaintenanceRepository] : &lt;&lt;check overlap&gt;&gt;\n[SystemValidationService] ..&gt; [BookingRepository] : &lt;&lt;check overlap&gt;&gt;\n[SystemValidationService] ..&gt; [OperatorRepository] : &lt;&lt;check is_eligible&gt;&gt;\n\n[UserRepository] --&gt; SQLServer\n[BookingRepository] --&gt; SQLServer\n[MachineRepository] --&gt; SQLServer\n[MaintenanceRepository] --&gt; SQLServer\n[OperatorRepository] --&gt; SQLServer\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6uIC45zU4fymqlX3Zgyy-15">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
