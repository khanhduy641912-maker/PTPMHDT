        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nautonumber\n\nactor User as \&quot;User (Nông dân / Chủ máy)\&quot;\nboundary HandoverUI\ncontrol HandoverController\nentity \&quot;Booking (Entity)\&quot; as Booking\nentity \&quot;Handover (Entity)\&quot; as Handover\nentity \&quot;Machine (Entity)\&quot; as Machine\n\nUser -&gt; HandoverUI: 1. Mở Form BM-03 (Nhập Odometer, % Nhiên liệu, Ghi chú hư hỏng)\nUser -&gt; HandoverUI: 2. Bấm \&quot;Xác nhận ký bàn giao\&quot;\nHandoverUI -&gt; HandoverController: 3. submitHandoverReport(bookingId, type, odometer, fuel, notes)\nHandoverController -&gt; Handover: 4. insertHandoverRecord(bookingId, type, odometer, fuel, notes)\nHandover --&gt; HandoverController: 5. handoverId\nalt #LightBlue Loại biên bản = &#39;CHECK_IN&#39;\n    HandoverController -&gt; Booking: 6. updateStatus(bookingId, &#39;IN_PROGRESS&#39;)\n    HandoverController -&gt; Machine: 7. updateStatus(machineId, &#39;IN_USE&#39;)\nelse #LightGreen Loại biên bản = &#39;CHECK_OUT&#39;\n    HandoverController -&gt; Booking: 8. updateStatus(bookingId, &#39;COMPLETED&#39;)\n    HandoverController -&gt; Machine: 9. updateStatus(machineId, &#39;AVAILABLE&#39;)\nend\nHandoverController --&gt; HandoverUI: 10. Return HandoverSuccess\nHandoverUI --&gt; User: 11. Thông báo \&quot;Nghiệm thu bàn giao hoàn tất\&quot;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yirKASJskIncktbe-xHL-257">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=13;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
