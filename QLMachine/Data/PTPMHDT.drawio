        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\n\nentity \&quot;USERS\&quot; as users {\n  + user_id : integer [PK]\n  --\n  full_name : string\n  phone : string\n  password_hash : string\n  role : enum (FARMER, OWNER, OPERATOR, ADMIN)\n  created_at : timestamp\n}\n\nentity \&quot;OPERATORS\&quot; as operators {\n  + operator_id : integer [PK]\n  --\n  # user_id : integer [FK]\n  license_no : string\n  is_eligible : boolean\n  hourly_rate : decimal\n}\n\nentity \&quot;MACHINES\&quot; as machines {\n  + machine_id : integer [PK]\n  --\n  # owner_id : integer [FK]\n  name : string\n  type : string\n  hourly_rate : decimal\n  status : enum (AVAILABLE, IN_MAINTENANCE, RESERVED)\n  created_at : timestamp\n}\n\nentity \&quot;MAINTENANCES\&quot; as maintenances {\n  + maintenance_id : integer [PK]\n  --\n  # machine_id : integer [FK]\n  start_time : datetime\n  end_time : datetime\n  description : text\n  status : enum (SCHEDULED, IN_PROGRESS, COMPLETED)\n}\n\nentity \&quot;BOOKINGS\&quot; as bookings {\n  + booking_id : integer [PK]\n  --\n  # farmer_id : integer [FK]\n  # machine_id : integer [FK]\n  # operator_id : integer [FK]\n  start_time : datetime\n  end_time : datetime\n  booking_time : datetime\n  total_fee : decimal\n  status : enum (PENDING, CONFIRMED, CANCELLED, IN_PROGRESS, COMPLETED)\n}\n\nentity \&quot;HANDOVERS\&quot; as handovers {\n  + handover_id : integer [PK]\n  --\n  # booking_id : integer [FK]\n  handover_time : datetime\n  machine_condition : text\n  type : enum (CHECK_IN, CHECK_OUT)\n  remarks : text\n}\n\n&#39; --- RELATIONSHIPS ---\nusers ||--o| operators : \&quot;kế thừa / mở rộng\&quot;\nusers ||--o{ machines : \&quot;sở hữu (1 - N)\&quot;\nmachines ||--o{ maintenances : \&quot;có lịch bảo trì (1 - N)\&quot;\nusers ||--o{ bookings : \&quot;đặt thuê (1 - N)\&quot;\nmachines ||--o{ bookings : \&quot;được đặt (1 - N)\&quot;\noperators ||--o{ bookings : \&quot;được phân công (0..1 - N)\&quot;\nbookings ||--o{ handovers : \&quot;chứa chứng từ (1 - 1..2)\&quot;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CwzNVZXmqSqznKO_Pod1-98">
