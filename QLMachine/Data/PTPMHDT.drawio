        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nautonumber\n\nactor Admin\nboundary AdminReviewUI\ncontrol OperatorController\nentity \&quot;Operators (Entity)\&quot; as OpEntity\n\nAdmin -&gt; AdminReviewUI: 1. Xem danh sách Tài xế chờ duyệt &amp; Ảnh bằng cấp\nAdmin -&gt; AdminReviewUI: 2. Bấm \&quot;Duyệt hợp lệ\&quot; (hoặc \&quot;Từ chối/Khóa\&quot;)\nAdminReviewUI -&gt; OperatorController: 3. setEligibilityStatus(operatorId, status, reason)\nalt #LightGreen Admin chọn Duyệt\n    OperatorController -&gt; OpEntity: 4. updateEligibility(operatorId, is_eligible = TRUE)\nelse #LightPink Admin chọn Từ chối / Khóa\n    OperatorController -&gt; OpEntity: 5. updateEligibility(operatorId, is_eligible = FALSE)\nend\nOpEntity --&gt; OperatorController: 6. Success\nOperatorController --&gt; AdminReviewUI: 7. Return ReviewCompleted\nAdminReviewUI --&gt; Admin: 8. Thông báo \&quot;Đã cập nhật trạng thái hợp lệ của Tài xế\&quot;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yirKASJskIncktbe-xHL-230">
