        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam shadowing false\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam roundcorner 8\n\nrectangle \&quot;1. Client Request\\nTrình duyệt gửi HTTP Request\\nkèm JSON Payload\&quot; as S1 #E8F5E9\nrectangle \&quot;2. DispatcherServlet\\nBộ định tuyến trung tâm Spring Boot\\n(/api/bookings)\&quot; as S2 #E3F2FD\nrectangle \&quot;3. Controller Layer\\nBookingController kiểm tra\\nRole &amp; xác thực Token\&quot; as S3 #E3F2FD\nrectangle \&quot;4. Service Layer\\nSystemValidationService chặn trùng lịch\\n&amp; tính tổng tiền (total_fee)\&quot; as S4 #E3F2FD\n\nrectangle \&quot;7. HTTP Response\\nController đóng gói JSON\\n(200 OK / 400 Bad Request)\&quot; as S7 #F3E5F5\ndatabase \&quot;6. SQL Server\\nLưu trữ bản ghi mới\\nvà trả về ID\&quot; as S6 #FFF8E1\nrectangle \&quot;5. Repository Layer\\nBookingRepository (Hibernate)\\nsinh câu lệnh INSERT INTO\&quot; as S5 #FFF8E1\n\nS1 -right-&gt; S2\nS2 -right-&gt; S3\nS3 -right-&gt; S4\nS4 -down-&gt; S5\nS5 -left-&gt; S6\nS6 -left-&gt; S7\nS7 -up-&gt; S1 : Trả kết quả\\nvề trình duyệt\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6uIC45zU4fymqlX3Zgyy-89">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
