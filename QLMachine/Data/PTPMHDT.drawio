        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nskinparam linetype ortho\n\nentity \&quot;Users\&quot; as users {\n  * user_id : INT &lt;&lt;PK&gt;&gt;\n  --\n  * full_name : NVARCHAR(100)\n  * phone : VARCHAR(20) &lt;&lt;UNIQUE&gt;&gt;\n  * password_hash : VARCHAR(255)\n  * role : VARCHAR(20)\n  created_at : DATETIME\n}\n\nentity \&quot;Operators\&quot; as operators {\n  * operator_id : INT &lt;&lt;PK&gt;&gt;\n  --\n  * user_id : INT &lt;&lt;FK&gt;&gt;\n  * license_no : VARCHAR(50)\n  * is_eligible : BIT\n  * hourly_rate : DECIMAL(10,2)\n}\n\nentity \&quot;Machines\&quot; as machines {\n  * machine_id : INT &lt;&lt;PK&gt;&gt;\n  --\n  * owner_id : INT &lt;&lt;FK&gt;&gt;\n  * name : NVARCHAR(100)\n  * type : NVARCHAR(50)\n  * hourly_rate : DECIMAL(10,2)\n  * status : VARCHAR(20)\n  created_at : DATETIME\n}\n\nentity \&quot;Maintenances\&quot; as maintenances {\n  * maintenance_id : INT &lt;&lt;PK&gt;&gt;\n  --\n  * machine_id : INT &lt;&lt;FK&gt;&gt;\n  * start_time : DATETIME\n  * end_time : DATETIME\n  description : NVARCHAR(MAX)\n  * status : VARCHAR(20)\n}\n\nentity \&quot;Bookings\&quot; as bookings {\n  * booking_id : INT &lt;&lt;PK&gt;&gt;\n  --\n  * farmer_id : INT &lt;&lt;FK&gt;&gt;\n  * machine_id : INT &lt;&lt;FK&gt;&gt;\n  operator_id : INT &lt;&lt;FK&gt;&gt;\n  * start_time : DATETIME\n  * end_time : DATETIME\n  booking_time : DATETIME\n  * total_fee : DECIMAL(12,2)\n  * status : VARCHAR(20)\n}\n\nentity \&quot;Handovers\&quot; as handovers {\n  * handover_id : INT &lt;&lt;PK&gt;&gt;\n  --\n  * booking_id : INT &lt;&lt;FK&gt;&gt;\n  handover_time : DATETIME\n  * machine_condition : NVARCHAR(MAX)\n  * type : VARCHAR(20)\n  remarks : NVARCHAR(MAX)\n}\n\nusers ||--o| operators : \&quot;1 - 0..1\&quot;\nusers ||--o{ machines : \&quot;1 - 0..*\&quot;\nmachines ||--o{ maintenances : \&quot;1 - 0..*\&quot;\nusers ||--o{ bookings : \&quot;1 - 0..*\&quot;\nmachines ||--o{ bookings : \&quot;1 - 0..*\&quot;\noperators ||--o{ bookings : \&quot;0..1 - 0..*\&quot;\nbookings ||--o{ handovers : \&quot;1 - 1..2\&quot;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CwzNVZXmqSqznKO_Pod1-0">
