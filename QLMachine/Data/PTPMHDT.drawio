        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nautonumber\n\nactor User\nboundary AuthUI\ncontrol AuthController\nentity \&quot;Users (Entity)\&quot; as Users\nentity \&quot;UserSessions (Entity)\&quot; as Sessions\n\nUser -&gt; AuthUI: 1. Nhập SĐT &amp; Mật khẩu\nAuthUI -&gt; AuthController: 2. login(phone, password)\nAuthController -&gt; Users: 3. findByPhone(phone)\nUsers --&gt; AuthController: 4. userRecord\nalt #LightPink Tài khoản không tồn tại / Sai mật khẩu\n    AuthController -&gt; AuthController: 5. verifyPassword(hash) [Fail]\n    AuthController --&gt; AuthUI: 6. Exception(\&quot;Tài khoản hoặc mật khẩu không chính xác\&quot;)\n    AuthUI --&gt; User: 7. Hiển thị thông báo lỗi\nelse #LightGreen Đăng nhập thành công\n    AuthController -&gt; AuthController: 8. verifyPassword(hash) [Success]\n    AuthController -&gt; Sessions: 9. createSession(userId, token, expiresAt)\n    Sessions --&gt; AuthController: 10. sessionToken\n    AuthController --&gt; AuthUI: 11. Return JWT Token &amp; UserRole\n    AuthUI --&gt; User: 12. Chuyển hướng tới Dashboard theo Role\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yirKASJskIncktbe-xHL-1">
