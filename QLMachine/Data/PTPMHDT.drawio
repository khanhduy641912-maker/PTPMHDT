        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nskinparam state {\n  BorderColor Black\n  BackgroundColor White\n}\n\n[*] --&gt; DRAFT : Kích hoạt Tạo biên bản (UC09)\n\nstate DRAFT {\n  DRAFT : do / Nhập Odometer, Nhiên liệu %, Hư hỏng\n}\n\nDRAFT --&gt; CHECK_IN_SIGNED : Hai bên ký nhận máy [Type = CHECK_IN]\nDRAFT --&gt; CHECK_OUT_SIGNED : Hai bên ký trả máy [Type = CHECK_OUT]\n\nstate CHECK_IN_SIGNED {\n  CHECK_IN_SIGNED : entry / Chuyển Booking sang IN_PROGRESS\n  CHECK_IN_SIGNED : entry / Lưu vết chỉ số máy lúc nhận\n}\n\nstate CHECK_OUT_SIGNED {\n  CHECK_OUT_SIGNED : entry / Chuyển Booking sang COMPLETED\n  CHECK_OUT_SIGNED : entry / Cập nhật chỉ số máy cuối cùng\n  CHECK_OUT_SIGNED : entry / Trả Machine về AVAILABLE\n}\n\nCHECK_IN_SIGNED --&gt; [*]\nCHECK_OUT_SIGNED --&gt; [*]\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="bVx3PnTwcK6pCwOUdKxf-72">
