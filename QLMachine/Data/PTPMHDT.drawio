        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nautonumber\n\nactor Owner\nboundary BookingListUI\ncontrol BookingController\nentity \&quot;Booking (Entity)\&quot; as Booking\nentity \&quot;Machine (Entity)\&quot; as Machine\n\nOwner -&gt; BookingListUI: 1. Xem danh sách đơn PENDING\nOwner -&gt; BookingListUI: 2. Bấm \&quot;Duyệt đơn\&quot; (hoặc \&quot;Từ chối\&quot;)\nBookingListUI -&gt; BookingController: 3. processBookingDecision(bookingId, decision, reason)\nalt #LightBlue Trường hợp Chủ máy chọn \&quot;Duyệt\&quot;\n    BookingController -&gt; Booking: 4. updateStatus(bookingId, &#39;CONFIRMED&#39;)\n    BookingController -&gt; Machine: 5. updateStatus(machineId, &#39;RESERVED&#39;)\n    BookingController --&gt; BookingListUI: 6. Return Success(\&quot;Đã duyệt đơn\&quot;)\nelse #LightPink Trường hợp Chủ máy chọn \&quot;Từ chối\&quot;\n    BookingController -&gt; Booking: 7. updateStatus(bookingId, &#39;CANCELLED&#39;, reason)\n    BookingController --&gt; BookingListUI: 8. Return Success(\&quot;Đã từ chối đơn\&quot;)\nend\nBookingListUI --&gt; Owner: 9. Cập nhật giao diện &amp; Gửi thông báo tới Nông dân\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yirKASJskIncktbe-xHL-180">
