        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\n&#39; Boundary Classes\nclass \&quot;CheckoutForm\&quot; as CheckoutForm &lt;&lt;Boundary&gt;&gt; {\n  + displayCartInfo()\n  + captureShippingInfo()\n  + onSubmitOrder()\n  + onSelectPaymentMethod()\n}\n\nclass \&quot;PaymentGatewayCallbackHandler\&quot; as PaymentCallback &lt;&lt;Boundary&gt;&gt; {\n  + receiveIPN(jsonPayload)\n  + returnResponse()\n}\n\n&#39; Control Classes\nclass \&quot;OrderController\&quot; as OrderController &lt;&lt;Control&gt;&gt; {\n  + processCheckout(cart, customerInfo): Order\n  + cancelOrder(orderId)\n}\n\nclass \&quot;PaymentController\&quot; as PaymentController &lt;&lt;Control&gt;&gt; {\n  + initiatePayment(orderId): String\n  + handlePaymentResult(txnData): boolean\n}\n\n&#39; Entity Classes\nclass \&quot;Order\&quot; as Order &lt;&lt;Entity&gt;&gt; {\n  - orderId: String\n  - totalAmount: double\n  - status: OrderStatus\n  - reserveToken: String\n  + calculateTotal()\n  + updateStatus(status)\n}\n\nclass \&quot;OrderItem\&quot; as OrderItem &lt;&lt;Entity&gt;&gt; {\n  - sku: String\n  - quantity: int\n  - unitPrice: double\n}\n\nclass \&quot;Customer\&quot; as Customer &lt;&lt;Entity&gt;&gt; {\n  - customerId: String\n  - fullName: String\n  - email: String\n  - phone: String\n  - shippingAddress: String\n}\n\n&#39; External Interfaces\ninterface \&quot;IProductSystemAdapter\&quot; as IProductAdapter {\n  + reserveStock(items): String\n  + deductStock(reserveToken): boolean\n}\n\ninterface \&quot;IPaymentGatewayAdapter\&quot; as IPaymentAdapter {\n  + createPaymentUrl(orderId, amount): String\n  + verifySignature(data): boolean\n}\n\ninterface \&quot;IEmailServiceAdapter\&quot; as IEmailAdapter {\n  + sendEmail(to, template, data): boolean\n}\n\n&#39; Relationships\nCheckoutForm --&gt; OrderController\nPaymentCallback --&gt; PaymentController\n\nOrderController --&gt; Order\nOrderController --&gt; Customer\nOrderController ..&gt; IProductAdapter\nOrderController ..&gt; IEmailAdapter\n\nPaymentController --&gt; Order\nPaymentController ..&gt; IPaymentAdapter\nPaymentController ..&gt; IEmailAdapter\n\nOrder \&quot;1\&quot; *-- \&quot;1..*\&quot; OrderItem\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ywLMo-lDSTFocYmoMxag-364">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
