        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nnode \&quot;Client Device\&quot; as ClientNode {\n    artifact \&quot;Web Browser\&quot; as Browser\n}\n\nnode \&quot;Web / Application Server\&quot; as AppNode {\n    node \&quot;Docker Container: API\&quot; {\n        artifact \&quot;Library System Web API (.NET / Spring Boot / Django)\&quot; as WebAPI\n    }\n}\n\nnode \&quot;Database Server\&quot; as DBNode {\n    database \&quot;PostgreSQL / MSSQL Server\&quot; as DBInstance\n}\n\nnode \&quot;File Server / S3 Storage\&quot; as FileNode {\n    artifact \&quot;PDF &amp; Document Storage\&quot; as EbookFiles\n}\n\nnode \&quot;Mail Server\&quot; as MailNode {\n    artifact \&quot;SMTP Gateway\&quot; as SMTP\n}\n\nBrowser -- AppNode : HTTPS (Port 443)\nWebAPI -- DBInstance : TCP/IP (Database Connection)\nWebAPI -- EbookFiles : Storage API / NFS\nWebAPI -- SMTP : SMTP (Port 587)\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ic-SwDjKgKeacoT8_972-25">
