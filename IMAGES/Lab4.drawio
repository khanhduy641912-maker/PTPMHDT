        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\n&#39; UI Layer\npackage \&quot;com.eshopping.ui\&quot; {\n  class CheckoutFrame {\n    - orderService: OrderService\n    - paymentService: PaymentService\n    + btnSubmit_Click()\n  }\n}\n\n&#39; Service Layer\npackage \&quot;com.eshopping.service\&quot; {\n  class OrderService {\n    - orderRepo: IOrderRepository\n    - productAdapter: IProductAdapter\n    - emailAdapter: IEmailAdapter\n    + createOrder(dto: OrderDTO): Order\n  }\n\n  class PaymentService {\n    - orderRepo: IOrderRepository\n    - paymentAdapter: IPaymentAdapter\n    - emailAdapter: IEmailAdapter\n    + processPayment(orderId: String): String\n    + processIPN(params: Map): boolean\n  }\n}\n\n&#39; Adapter Layer\npackage \&quot;com.eshopping.adapter\&quot; {\n  interface IPaymentAdapter {\n    + generateUrl(orderId: String, amount: double): String\n    + validateIPN(params: Map): boolean\n  }\n\n  class MoMoPaymentAdapter implements IPaymentAdapter {\n    - secretKey: String\n    - partnerCode: String\n    + generateUrl(orderId: String, amount: double): String\n    + validateIPN(params: Map): boolean\n  }\n\n  interface IProductAdapter {\n    + reserveStock(items: List): String\n  }\n\n  class ExternalPIMAdapter implements IProductAdapter {\n    - baseUrl: String\n    + reserveStock(items: List): String\n  }\n\n  interface IEmailAdapter {\n    + sendOrderEmail(email: String, template: String, data: Map): void\n  }\n\n  class SendGridEmailAdapter implements IEmailAdapter {\n    - apiKey: String\n    + sendOrderEmail(email: String, template: String, data: Map): void\n  }\n}\n\n&#39; Data Layer\npackage \&quot;com.eshopping.repository\&quot; {\n  interface IOrderRepository {\n    + save(order: Order): boolean\n    + findById(id: String): Order\n    + updateStatus(id: String, status: String): boolean\n  }\n\n  class OrderRepositoryImpl implements IOrderRepository {\n    - dbConnection: Connection\n    + save(order: Order): boolean\n    + findById(id: String): Order\n    + updateStatus(id: String, status: String): boolean\n  }\n}\n\nCheckoutFrame --&gt; OrderService\nCheckoutFrame --&gt; PaymentService\nOrderService --&gt; IOrderRepository\nOrderService --&gt; IProductAdapter\nOrderService --&gt; IEmailAdapter\nPaymentService --&gt; IPaymentAdapter\nPaymentService --&gt; IOrderRepository\nPaymentService --&gt; IEmailAdapter\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="cVKcSKejDYGhiUsjtR07-279">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
