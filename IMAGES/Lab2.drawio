        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nclass NguoiDung {\n    - maNguoiDung: String\n    - hoTen: String\n    - email: String\n    - soDienThoai: String\n    + dangNhap(): Boolean\n    + dangXuat(): Void\n}\n\nclass DocGia {\n    - maThe: String\n    - ngayHetHan: Date\n    - trangThaiThe: String\n    + timKiemTaiLieu(): List&lt;TaiLieu&gt;\n    + dangKyMuon(): Boolean\n    + taiTaiLieuDienTu(): Void\n}\n\nclass ThuThu {\n    - maNhanVien: String\n    + quanLySach(): Void\n    + xacNhanMuonTra(): Void\n    + duyetyeuCauMua(): Void\n}\n\nclass TaiLieu {\n    - maTaiLieu: String\n    - tenTaiLieu: String\n    - tácGia: String\n    - namXuatBan: Int\n    - theLoai: String\n    + layThongTin(): String\n}\n\nclass SachIn {\n    - viTriKe: String\n    - tongSoLuong: Int\n    - soLuongKhaDung: Int\n    + capNhatSoLuong(soLuong: Int): Void\n}\n\nclass TaiLieuDienTu {\n    - dungLuong: Float\n    - dinhDang: String\n    - duongDanFile: String\n    + choPhepTai(): Boolean\n}\n\nclass PhieuMuon {\n    - maPhieuMuon: String\n    - ngayMuon: Date\n    - ngayHenTra: Date\n    - trangThai: String\n    + taoPhieuMuon(): Boolean\n    + capNhatTrangThai(trangThai: String): Void\n}\n\nclass ChiTietPhieuMuon {\n    - maChiTiet: String\n    - ngayTraThucTe: Date\n    - tienPhat: Double\n    + tinhTienPhat(): Double\n}\n\nNguoiDung &lt;|-- DocGia\nNguoiDung &lt;|-- ThuThu\n\nTaiLieu &lt;|-- SachIn\nTaiLieu &lt;|-- TaiLieuDienTu\n\nDocGia \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuMuon : tao &gt;\nThuThu \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuMuon : xac nhan &gt;\nPhieuMuon \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhieuMuon\nSachIn \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuMuon\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="tOnK6KRgpxcwzE-u8ybk-1">
