        <UserObject label="BIỂU ĐỒ HOẠT ĐỘNG - ĐĂNG KÝ ĐẾN NHẬN TOA THUỐC" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="BIỂU ĐỒ HOẠT ĐỘNG - ĐĂNG KÝ ĐẾN NHẬN TOA THUỐC" id="Ql3XxNmrbvXRATePYnFa-506">
