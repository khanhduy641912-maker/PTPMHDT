        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml UseCase_PhanRa_KhamBenh_ToaThuoc\nleft to right direction\ntitle PHẦN RÃ 2: QUY TRÌNH KHÁM BỆNH, XÉT NGHIỆM VÀ LẬP TOA THUỐC\n\nactor \&quot;Bác sĩ Điều trị\&quot; as BS\nactor \&quot;Kỹ thuật viên Xét nghiệm\&quot; as KTV\n\nrectangle \&quot;Phân hệ Khám bệnh &amp; Điều trị\&quot; {\n    usecase \&quot;Tra cứu lý lịch bệnh án\&quot; as UC_TraCuu\n    usecase \&quot;Lập phiếu khám bệnh\&quot; as UC_LapPhieu\n    usecase \&quot;Ghi nhận chỉ số triệu chứng\&quot; as UC_TrieuChung\n    usecase \&quot;Chỉ định xét nghiệm\&quot; as UC_ChiDinhXN\n    usecase \&quot;Nhập kết quả xét nghiệm\&quot; as UC_NhapKetQuaXN\n    usecase \&quot;Lập toa thuốc điều trị\&quot; as UC_LapToa\n    usecase \&quot;Kiểm tra chống chỉ định thuốc\&quot; as UC_KiemTraThuoc\n}\n\nBS -- UC_TraCuu\nBS -- UC_LapPhieu\nBS -- UC_ChiDinhXN\nBS -- UC_LapToa\n\nKTV -- UC_NhapKetQuaXN\n\n&#39; Quan hệ Include / Extend\nUC_LapPhieu .&gt; UC_TraCuu : &lt;&lt;include&gt;&gt;\nUC_LapPhieu .&gt; UC_TrieuChung : &lt;&lt;include&gt;&gt;\n\nUC_LapPhieu &lt;.. UC_ChiDinhXN : &lt;&lt;extend&gt;&gt;\nUC_NhapKetQuaXN .&gt; UC_ChiDinhXN : &lt;&lt;include&gt;&gt;\n\nUC_LapPhieu &lt;.. UC_LapToa : &lt;&lt;extend&gt;&gt;\nUC_LapToa .&gt; UC_KiemTraThuoc : &lt;&lt;include&gt;&gt;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Ql3XxNmrbvXRATePYnFa-72">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
