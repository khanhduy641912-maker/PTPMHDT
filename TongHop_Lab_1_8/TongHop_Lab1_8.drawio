        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nclass PhongBan {\n    - MaPB : String\n    - TenPB : String\n    + themPhongBan()\n}\nclass ChucVu {\n    - MaCV : String\n    - TenCV : String\n    - MucPhuCap : Float\n    + themChucVu()\n}\nclass CaLamViec {\n    - MaCa : String\n    - TenCa : String\n    - GioBatDau : Time\n    - GioKetThuc : Time\n    + themCa()\n}\n\nclass NhanVien {\n    - MaNV : String\n    - HoTen : String\n    - NgaySinh : Date\n    - DiaChi : String\n    - MaPB : String\n    + capNhatThongTin()\n}\nclass QuyetDinhTuyenDung {\n    - SoQDTD : String\n    - NgayQD : Date\n    - ThoiGianThuViec : Int\n    - MucLuongThuViec : Float\n    - DieuKhoan : String\n    - MaNV : String\n    + lapQuyetDinh()\n}\nclass HopDong {\n    - SoHD : String\n    - LoaiHD : String\n    - NgayKy : Date\n    - NgayHetHan : Date\n    - MaNV : String\n    + kyHopDong()\n}\nclass HoSoBaoHiem {\n    - MaHS : String\n    - SoHD : String\n    - MucDongBHYT : Float\n    - MucDongBHXH : Float\n    + lapHoSo()\n}\nclass QuyetDinhChucVu {\n    - SoQDCV : String\n    - NgayHieuLuc : Date\n    - MaCV : String\n    - MaNV : String\n    + lapQuyetDinh()\n}\nclass QuyetDinhLuong {\n    - SoQDL : String\n    - NgayHieuLuc : Date\n    - MucLuongCoBan : Float\n    - PhuCapLuong : Float\n    - PhuCapDocHai : Float\n    - MaNV : String\n    + lapQuyetDinh()\n}\n\nclass QuyetDinhKhenThuong {\n    - SoQDKT : String\n    - NgayQD : Date\n    - NoiDung : String\n    - MucThuong : Float\n    - MaNV : String\n    - MaPB : String\n    + lapQuyetDinh()\n}\nclass PhieuChiKhenThuong {\n    - SoPhieuChi : String\n    - NgayChi : Date\n    - SoTien : Float\n    - SoQDKT : String\n    + lapPhieu()\n}\nclass QuyetDinhKyLuat {\n    - SoQDKL : String\n    - NgayQD : Date\n    - NoiDung : String\n    - MucPhat : Float\n    - MaNV : String\n    - MaPB : String\n    + lapQuyetDinh()\n}\nclass PhieuThuNopPhat {\n    - SoPhieuThu : String\n    - NgayThu : Date\n    - SoTien : Float\n    - SoQDKL : String\n    + lapPhieu()\n}\n\nclass KeHoachPhanCong {\n    - MaKHC : String\n    - Tuan : Int\n    - Nam : Int\n    - MaCa : String\n    - MaNV : String\n    - MaPB : String\n    + lapKeHoach()\n}\nclass PhieuPhuTroi {\n    - SoPhieuPT : String\n    - NgayPhuTroi : Date\n    - HinhThuc : String\n    + lapPhieu()\n}\nclass ChiTietPhuTroi {\n    - SoPhieuPT : String\n    - MaNV : String\n    - SoGio : Float\n    - GioQuyDoi : Float\n    + tinhGioQuyDoi()\n}\nclass BangChamCong {\n    - MaBCC : String\n    - Thang : Int\n    - Nam : Int\n    - MaPB : String\n    + lapBangChamCong()\n}\nclass ChiTietChamCong {\n    - MaBCC : String\n    - MaNV : String\n    - SoNgayLamViec : Float\n    + lapChiTiet()\n}\nclass BangLuong {\n    - MaBL : String\n    - Thang : Int\n    - Nam : Int\n    - TongLuong : Float\n    - ThucLanh : Float\n    - MaNV : String\n    + tinhLuongHangThang()\n}\n\nPhongBan \&quot;1\&quot; -- \&quot;*\&quot; NhanVien\nChucVu \&quot;1\&quot; -- \&quot;*\&quot; QuyetDinhChucVu\n\nNhanVien \&quot;1\&quot; -- \&quot;0..1\&quot; QuyetDinhTuyenDung\nNhanVien \&quot;1\&quot; -- \&quot;*\&quot; HopDong\nHopDong \&quot;1\&quot; -- \&quot;0..1\&quot; HoSoBaoHiem\nNhanVien \&quot;1\&quot; -- \&quot;*\&quot; QuyetDinhChucVu\nNhanVien \&quot;1\&quot; -- \&quot;*\&quot; QuyetDinhLuong\n\nNhanVien \&quot;1\&quot; -- \&quot;*\&quot; QuyetDinhKhenThuong\nPhongBan \&quot;1\&quot; -- \&quot;*\&quot; QuyetDinhKhenThuong\nQuyetDinhKhenThuong \&quot;1\&quot; -- \&quot;1\&quot; PhieuChiKhenThuong\n\nNhanVien \&quot;1\&quot; -- \&quot;*\&quot; QuyetDinhKyLuat\nPhongBan \&quot;1\&quot; -- \&quot;*\&quot; QuyetDinhKyLuat\nQuyetDinhKyLuat \&quot;1\&quot; -- \&quot;1\&quot; PhieuThuNopPhat\n\nCaLamViec \&quot;1\&quot; -- \&quot;*\&quot; KeHoachPhanCong\nNhanVien \&quot;1\&quot; -- \&quot;*\&quot; KeHoachPhanCong\nPhongBan \&quot;1\&quot; -- \&quot;*\&quot; KeHoachPhanCong\n\nPhieuPhuTroi \&quot;1\&quot; *-- \&quot;*\&quot; ChiTietPhuTroi\nNhanVien \&quot;1\&quot; -- \&quot;*\&quot; ChiTietPhuTroi\n\nBangChamCong \&quot;1\&quot; *-- \&quot;*\&quot; ChiTietChamCong\nNhanVien \&quot;1\&quot; -- \&quot;*\&quot; ChiTietChamCong\nPhongBan \&quot;1\&quot; -- \&quot;*\&quot; BangChamCong\n\nNhanVien \&quot;1\&quot; -- \&quot;*\&quot; BangLuong\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EiRFh_E-U4qB7Ig-b02G-1">
