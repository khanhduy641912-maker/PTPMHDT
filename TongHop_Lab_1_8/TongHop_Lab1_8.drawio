        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\npackage \&quot;Presentation Layer (UI)\&quot; {\n    package \&quot;Controllers\&quot; {\n        class BookController\n        class BorrowController\n        class UserController\n    }\n    package \&quot;Views / DTOs\&quot; {\n        class BookDTO\n        class BorrowDTO\n    }\n}\n\npackage \&quot;Business Logic Layer (Services)\&quot; {\n    class BookService\n    class BorrowService\n    class UserService\n    class EmailService\n}\n\npackage \&quot;Data Access Layer (Repositories)\&quot; {\n    class BookRepository\n    class BorrowRepository\n    class UserRepository\n}\n\npackage \&quot;Database Layer\&quot; {\n    class DatabaseContext\n}\n\n\&quot;Presentation Layer (UI)\&quot; ..&gt; \&quot;Business Logic Layer (Services)\&quot; : uses\n\&quot;Business Logic Layer (Services)\&quot; ..&gt; \&quot;Data Access Layer (Repositories)\&quot; : uses\n\&quot;Data Access Layer (Repositories)\&quot; ..&gt; \&quot;Database Layer\&quot; : accesses\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CKVYyqRph5cWWtNZqzaj-66">
