        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\nactor \&quot;NV Quản lý\&quot; as NV_QuanLy\nactor \&quot;Kế toán\&quot; as KeToan\n\nrectangle \&quot;Quy trình: Thuê văn phòng -&gt; Thanh toán\&quot; {\n    usecase \&quot;Lập hợp đồng thuê phòng\&quot; as UC_LapHopDong\n    usecase \&quot;Chọn danh sách phòng thuê\&quot; as UC_ChonDanhSachPhong\n    usecase \&quot;Thanh toán 6 tháng đầu\&quot; as UC_ThanhToan6Thang\n\n    usecase \&quot;Thanh toán tiền nhà hàng tháng\&quot; as UC_ThanhToanTienNha\n    usecase \&quot;Kiểm tra hợp đồng &gt; 6 tháng\&quot; as UC_KiemTraHopDong\n\n    usecase \&quot;Thanh toán phí dịch vụ\&quot; as UC_ThanhToanPhiDichVu\n    usecase \&quot;Ghi nhận chỉ số &amp; thanh toán dịch vụ cuối tháng\&quot; as UC_GhiNhanDichVu\n}\n\n&#39; Liên kết giữa Actor và Use Case chính\nNV_QuanLy --&gt; UC_LapHopDong\nKeToan --&gt; UC_ThanhToanTienNha\nKeToan --&gt; UC_ThanhToanPhiDichVu\n\n&#39; Quan hệ &lt;&lt;include&gt;&gt; giữa các Use Case\nUC_LapHopDong .&gt; UC_ChonDanhSachPhong : &lt;&lt;include&gt;&gt;\nUC_LapHopDong .&gt; UC_ThanhToan6Thang : &lt;&lt;include&gt;&gt;\n\nUC_ThanhToanTienNha .&gt; UC_KiemTraHopDong : &lt;&lt;include&gt;&gt;\n\nUC_ThanhToanPhiDichVu .&gt; UC_GhiNhanDichVu : &lt;&lt;include&gt;&gt;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Gg-X5MNlFoOrV6j1K4er-33">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
