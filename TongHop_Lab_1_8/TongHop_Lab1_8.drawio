        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nskinparam SequenceMessageAlignment center\n\nactor \&quot;NV_QuanLy\&quot; as NV\nboundary \&quot;FrmGiaHan\&quot; as Frm\ncontrol \&quot;GiaHanService\&quot; as Service\nentity \&quot;HopDongThue\&quot; as HD\nentity \&quot;HoaDonTienNha\&quot; as HDN\nentity \&quot;HoaDonDichVu\&quot; as HDDV\nentity \&quot;PhieuGiaHan\&quot; as PGH\n\nNV -&gt; Frm : Chọn HĐ &amp; Nhập phiếu\nactivate Frm\n\nFrm -&gt; Service : LapGiaHan()\nactivate Service\n\nService -&gt; HD : KiemTraHan()\nactivate HD\nHD --&gt; Service : SoThang, NgayKT\ndeactivate HD\n\nService -&gt; HDN : KiemTraNoTienNha()\nactivate HDN\nHDN --&gt; Service : ConNoTienNha\ndeactivate HDN\n\nService -&gt; HDDV : KiemTraNoDichVu()\nactivate HDDV\nHDDV --&gt; Service : ConNoDichVu\ndeactivate HDDV\n\nalt SoThangGH &gt; 1/2 SoThangThue HOẶC ConNoTienNha HOẶC ConNoDichVu\n    Service --&gt; Frm : Fail(LyDo)\nelse Hợp lệ - trong 1 Transaction\n    Service -&gt; HD : UpdateNgayKetHan()\n    activate HD\n    deactivate HD\n\n    Service -&gt; PGH : TaoPhieuGiaHan()\n    activate PGH\n    deactivate PGH\n\n    Service -&gt; Service : Commit()\n\n    Service --&gt; Frm : Ok(ThongBao)\nend\ndeactivate Service\n\nFrm --&gt; NV : Thông báo\ndeactivate Frm\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Gg-X5MNlFoOrV6j1K4er-376">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
