        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nleft to right direction\n\n&#39; --- DANH SÁCH CÁC LỚP ---\n\nclass Tang {\n    - MaTang: String\n    - TenTang: String\n    - ViTri: String\n    + themTang(): void\n    + capNhatTang(): void\n}\n\nclass Phong {\n    - MaPhong: String\n    - MaTang: String\n    - TenPhong: String\n    - DienTich: Decimal\n    - HuongPhong: String\n    - DonGiaThue: Decimal\n    - TrangThai: String\n    + themPhong(): void\n    + layDonGia(): Decimal\n    + capNhatTrangThai(): void\n}\n\nclass KhachHang {\n    - MaKH: String\n    - TenCongTy: String\n    - NguoiDaiDien: String\n    - DienThoai: String\n    - MaSoThue: String\n    - DiaChi: String\n    + themKhachHang(): void\n    + capNhatThongTin(): void\n}\n\nclass HopDongThue {\n    - SoHopDong: String\n    - MaKH: String\n    - NgayLap: DateTime\n    - NgayBatDau: Date\n    - SoThangThue: Integer\n    - NgayKetHan: Date\n    - TienCoc: Decimal\n    - TrangThai: String\n    + lapHopDong(): void\n    + tinhNgayKetHan(): Date\n    + tinhTienThangDau(): Decimal\n    + thanhToanThangDau(): void\n}\n\nclass ChiTietHopDong {\n    - SoHopDong: String\n    - MaPhong: String\n    - DonGiaThueTaiThoiDiem: Decimal\n    + themPhongThue(): void\n    + xoaPhongThue(): void\n}\n\nclass PhieuGiaHan {\n    - SoPhieuGH: String\n    - SoHopDong: String\n    - MaPhong: String\n    - NgayLap: Date\n    - SoThangGiaHan: Integer\n    - NgayKetHanMoi: Date\n    - GhiChu: String\n    + lapPhieuGiaHan(): void\n    + kiemTraDieuKienGH(): Boolean\n    + tinhNgayKetHanMoi(): Date\n}\n\nclass HoaDonTienNha {\n    - SoHDNha: String\n    - SoHopDong: String\n    - ThangNam: String\n    - NgayLap: Date\n    - SoTien: Decimal\n    - DaThanhToan: Boolean\n    + lapHoaDonTienNha(): void\n    + thanhToanTienNha(): void\n}\n\nclass DichVu {\n    - MaDV: String\n    - TenDichVu: String\n    - DonViTinh: String\n    - DonGia: Decimal\n    + themDichVu(): void\n    + capNhatGia(): void\n}\n\nclass HoaDonDichVu {\n    - SoHDDV: String\n    - SoHopDong: String\n    - MaDV: String\n    - ThangNam: String\n    - NgayLap: Date\n    - ChiSoCu: Decimal\n    - ChiSoMoi: Decimal\n    - TongTien: Decimal\n    - DaThanhToan: Boolean\n    + lapHoaDonDV(): void\n    + tinhTienDichVu(): Decimal\n    + thanhToanDichVu(): void\n}\n\nclass NhanVienCongTy {\n    - MaNV: String\n    - MaKH: String\n    - MaPhong: String\n    - HoTen: String\n    - HinhAnh: String\n    - ChucVu: String\n    - DienThoai: String\n    + themNhanVien(): void\n    + chuyenPhong(): void\n}\n\nclass TheGiuXe {\n    - MaThe: String\n    - MaNV: String\n    - BienSoXe: String\n    - LoaiXe: String\n    - NgayCap: Date\n    + capTheXe(): void\n    + thuHoiThe(): void\n}\n\nclass PhieuKiemDinh {\n    - MaPhieuKD: String\n    - MaPhong: String\n    - NgayKiemTra: Date\n    - TinhTrangPhong: String\n    - CoViPham: Boolean\n    + lapPhieuKiemDinh(): void\n}\n\nclass BienBanViPham {\n    - MaBB: String\n    - MaPhieuKD: String\n    - NgayLap: Date\n    - HanhViViPham: String\n    - SoTienPhat: Decimal\n    - DaNopPhat: Boolean\n    + lapBienBan(): void\n    + nopTienPhat(): void\n}\n\n&#39; --- MỐI QUAN HỆ GIỮA CÁC LỚP ---\n\nTang \&quot;1\&quot; *-- \&quot;1..*\&quot; Phong : Chứa &gt;\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; HopDongThue : Ký &gt;\nHopDongThue \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietHopDong : Thuộc &gt;\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietHopDong : Được thuê &gt;\n\nHopDongThue \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGiaHan : Có &gt;\nHopDongThue \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDonTienNha : Sinh ra &gt;\nHopDongThue \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDonDichVu : Sinh ra &gt;\nDichVu \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDonDichVu : Tính tiền &gt;\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVienCongTy : Có &gt;\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVienCongTy : Làm việc tại &gt;\nNhanVienCongTy \&quot;1\&quot; -- \&quot;0..1\&quot; TheGiuXe : Được cấp &gt;\n\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKiemDinh : Được kiểm tra &gt;\nPhieuKiemDinh \&quot;1\&quot; -- \&quot;0..1\&quot; BienBanViPham : Xử lý vi phạm &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Gg-X5MNlFoOrV6j1K4er-53">
