        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\npackage \&quot;Client Tier\&quot; {\n    [Web Browser / Mobile App] as ClientApp\n}\n\npackage \&quot;Application Server (Backend)\&quot; {\n    component [API Gateway / Controller] as Controller\n    component [Auth Service] as AuthService\n    component [Catalog Service] as CatalogService\n    component [Borrowing Service] as BorrowService\n    component [Notification Service] as NotiService\n}\n\npackage \&quot;Data Tier\&quot; {\n    database \&quot;Relational Database\\n(PostgreSQL / SQL Server)\&quot; as DB\n    database \&quot;File Storage / Cloud Storage\\n(PDF/Ebook Files)\&quot; as FileStorage\n}\n\npackage \&quot;External Services\&quot; {\n    [Email Service / SMTP] as SmtpServer\n}\n\nClientApp --&gt; Controller : HTTP/HTTPS (REST API)\n\nController --&gt; AuthService : Verify Auth\nController --&gt; CatalogService : Manage Books / Search\nController --&gt; BorrowService : Process Borrow/Return\nController --&gt; NotiService : Send Reminders\n\nCatalogService --&gt; DB : CRUD Book Data\nCatalogService --&gt; FileStorage : Fetch E-books\nBorrowService --&gt; DB : CRUD Borrow Records &amp; Cards\nAuthService --&gt; DB : Validate User Info\n\nNotiService --&gt; SmtpServer : Send Emails\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CKVYyqRph5cWWtNZqzaj-1">
