        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nactor \&quot;Nhân sự\&quot; as NS\n\nusecase \&quot;Tiếp nhận và ký hợp đồng lao động\&quot; as UC_Main\nusecase \&quot;Lập quyết định tuyển dụng thử việc\&quot; as UC_TD\nusecase \&quot;Đánh giá kết quả hết thời gian thử việc\&quot; as UC_DG\nusecase \&quot;Ký hợp đồng dài hạn hoặc ngắn hạn\&quot; as UC_HD\nusecase \&quot;Lập hồ sơ bảo hiểm y tế và bảo hiểm xã hội\&quot; as UC_BH\nusecase \&quot;Lập quyết định chức vụ và phụ cấp\&quot; as UC_CV\nusecase \&quot;Lập quyết định lương chính thức\&quot; as UC_L\n\nNS -- UC_Main\n\nUC_Main ..&gt; UC_TD : &lt;&lt;include&gt;&gt;\nUC_Main ..&gt; UC_DG : &lt;&lt;include&gt;&gt;\nUC_Main ..&gt; UC_HD : &lt;&lt;include&gt;&gt;\n\nUC_BH ..&gt; UC_HD : &lt;&lt;extend&gt;&gt;\nUC_CV ..&gt; UC_HD : &lt;&lt;extend&gt;&gt;\nUC_HD ..&gt; UC_L : &lt;&lt;include&gt;&gt;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EiRFh_E-U4qB7Ig-b02G-360">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
