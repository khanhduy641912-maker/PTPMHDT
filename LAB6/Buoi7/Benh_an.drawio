        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml ActivityDiagram_QuyTrinhKham_Gon\nskinparam ActivityFontSize 12\nskinparam ActivityPadding 5\nskinparam ArrowFontSize 10\n\ntitle BIỂU ĐỒ HOẠT ĐỘNG - ĐĂNG KÝ ĐẾN NHẬN TOA THUỐC\n\n|#LightBlue|Bệnh nhân|\nstart\n:Đăng ký khám;\nif (Hồ sơ?) then (Chưa có)\n    :Điền thông tin &amp; Ảnh 3x4;\n    |#LightGreen|NV Tiếp nhận|\n    :Thu lệ phí năm;\n    :Cấp Mã hồ sơ &amp; In bìa;\nelse (Đã có)\n    |#LightBlue|Bệnh nhân|\n    :Cung cấp Mã hồ sơ/SĐT;\n    |#LightGreen|NV Tiếp nhận|\n    if (Lệ phí năm?) then (Hết hạn)\n        :Thu lệ phí gia hạn;\n    else (Còn hạn)\n    endif\nendif\n\n|#LightGreen|NV Tiếp nhận|\n:Lập Phiếu khám &amp; Xếp phòng;\n\n|#LightBlue|Bệnh nhân|\n:Chờ tại phòng khám;\n\n|#Yellow|Bác sĩ Điều trị|\n:Tra cứu lịch sử bệnh án;\n:Khám &amp; ghi nhận triệu chứng;\n\nif (Cần xét nghiệm?) then (Có)\n    :Chỉ định xét nghiệm;\n    |#LightGray|Xét nghiệm|\n    :Thực hiện &amp; nhập kết quả;\n    |#Yellow|Bác sĩ Điều trị|\n    :Xem kết quả xét nghiệm;\nelse (Không)\nendif\n\n|#Yellow|Bác sĩ Điều trị|\n:Chẩn đoán &amp; Lập toa thuốc;\n:Lưu đợt khám lên hệ thống;\n\n|#LightPink|NV CSKH / Thu ngân|\n:Tính viện phí (XN + Thuốc);\n|#LightBlue|Bệnh nhân|\n:Thanh toán viện phí;\n\n|#LightPink|NV CSKH / Thu ngân|\n:Hoàn tất đợt điều trị &amp; Phát thuốc;\n\n|#LightBlue|Bệnh nhân|\n:Nhận thuốc &amp; ra về;\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8BNnIWJf1vRXNfenMQxh-82">
