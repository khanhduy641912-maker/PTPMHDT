        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml ClassDiagram_QuanLyHoSoBenhAn\ntitle Biểu đồ lớp - Quản lý Hồ sơ Bệnh án Bệnh nhân\n\nclass BenhNhan {\n    +String MaBenhNhan\n    +String HoTen\n    +Date NgaySinh\n    +String DiaChi\n    +String SoDienThoai\n    +String Anh\n    +themBenhNhan()\n    +capNhatThongTin()\n}\n\nclass HoSoBenhAn {\n    +String MaHoSo\n    +String MaBenhNhan\n    +Date NgayLap\n    +Date NgayHetHanLePhi\n    +String TrangThai\n    +taomoiHoSo()\n    +giaHanLePhi()\n    +kiemTraLePhi()\n}\n\nclass LePhiNam {\n    +String MaLePhi\n    +String MaHoSo\n    +int Nam\n    +decimal SoTien\n    +Date NgayDong\n    +dongLePhi()\n    +layTrangThaiDong()\n}\n\nclass LichHenKham {\n    +String MaLichHen\n    +String MaHoSo\n    +DateTime NgayGioHen\n    +int Quy\n    +int Nam\n    +String TrangThai\n    +datLichHen()\n    +huyLichHen()\n    +xacNhanKham()\n}\n\nclass BacSi {\n    +String MaBacSi\n    +String HoTen\n    +String SoDienThoai\n    +String ChuyenKhoa\n    +traCuuHoSo()\n    +keToaThuoc()\n}\n\nclass KhoaDieuTri {\n    +String MaKhoa\n    +String TenKhoa\n    +String ViTri\n    +layDanhSachKhoa()\n}\n\nclass PhieuKhamBenh {\n    +String MaPhieuKham\n    +String MaHoSo\n    +String MaBacSi\n    +String MaKhoa\n    +DateTime NgayGioKham\n    +String LoaiKham\n    +String TrieuChung\n    +String KetLuanBenh\n    +bool TrangThaiThanhToan\n    +taoPhieuKham()\n    +capNhatTrieuChung()\n    +hoanTatKham()\n}\n\nclass XetNhiem {\n    +String MaXetNhiem\n    +String MaPhieuKham\n    +String TenXetNhiem\n    +String KetQua\n    +decimal ChiPhi\n    +taoChiDinh()\n    +capNhatKetQua()\n}\n\nclass ToaThuoc {\n    +String MaToa\n    +String MaPhieuKham\n    +Date NgayLap\n    +String GhiChu\n    +lapToaThuoc()\n    +tinhTongTien()\n}\n\nclass ChiTietToaThuoc {\n    +String MaToa\n    +String MaThuoc\n    +int SoLuong\n    +String LieuDung\n    +decimal DonGia\n    +themThuoc()\n    +tinhThanhTien()\n}\n\nclass Thuoc {\n    +String MaThuoc\n    +String TenThuoc\n    +String DonViTinh\n    +decimal DonGia\n    +String ChongChiDinh\n    +themThuoc()\n    +capNhatGia()\n}\n\nclass HoaDonVienPhi {\n    +String MaHoaDon\n    +String MaPhieuKham\n    +DateTime NgayThanhToan\n    +decimal TienXetNhiem\n    +decimal TienThuoc\n    +decimal TongTien\n    +String TrangThai\n    +tinhVienPhi()\n    +xacNhanThanhToan()\n}\n\nBenhNhan \&quot;1\&quot; -- \&quot;1\&quot; HoSoBenhAn\nHoSoBenhAn \&quot;1\&quot; -- \&quot;0..*\&quot; LePhiNam\nHoSoBenhAn \&quot;1\&quot; -- \&quot;0..*\&quot; LichHenKham\nHoSoBenhAn \&quot;1\&quot; -- \&quot;1..*\&quot; PhieuKhamBenh\nKhoaDieuTri \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKhamBenh\nBacSi \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKhamBenh\nPhieuKhamBenh \&quot;1\&quot; -- \&quot;0..*\&quot; XetNhiem\nPhieuKhamBenh \&quot;1\&quot; -- \&quot;0..1\&quot; ToaThuoc\nToaThuoc \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietToaThuoc\nThuoc \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietToaThuoc\nPhieuKhamBenh \&quot;1\&quot; -- \&quot;1\&quot; HoaDonVienPhi\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5Lks6a9vUfCVvubyJWK2-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
