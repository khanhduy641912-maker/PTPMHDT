        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml UseCase_PhanRa_DangKy\nleft to right direction\ntitle PHẦN RÃ 1: QUY TRÌNH ĐĂNG KÝ BỆNH NHÂN VÀ CẤP HỒ SƠ\n\nactor \&quot;Bệnh nhân\&quot; as BN\nactor \&quot;Nhân viên Tiếp nhận / Thu ngân\&quot; as NVTN\n\nrectangle \&quot;Phân hệ Đăng ký &amp; Quản lý Hồ sơ\&quot; {\n    usecase \&quot;Nhập thông tin bệnh nhân\&quot; as UC_NhapTT\n    usecase \&quot;Tải ảnh 3x4 bệnh nhân\&quot; as UC_TaiAnh\n    usecase \&quot;Thu lệ phí quản lý hằng năm\&quot; as UC_ThuLePhi\n    usecase \&quot;Cấp Mã hồ sơ bệnh án\&quot; as UC_CapMa\n    usecase \&quot;In trang bìa hồ sơ bệnh án\&quot; as UC_InBia\n    usecase \&quot;Đặt lịch hẹn khám định kỳ quý\&quot; as UC_DatLich\n    usecase \&quot;Kiểm tra thời hạn lệ phí năm\&quot; as UC_KiemTraLePhi\n}\n\nBN -- UC_NhapTT\nBN -- UC_ThuLePhi\nBN -- UC_DatLich\n\nNVTN -- UC_NhapTT\nNVTN -- UC_ThuLePhi\nNVTN -- UC_CapMa\nNVTN -- UC_InBia\nNVTN -- UC_DatLich\n\n&#39; Quan hệ Include / Extend\nUC_NhapTT .&gt; UC_TaiAnh : &lt;&lt;include&gt;&gt;\nUC_CapMa .&gt; UC_NhapTT : &lt;&lt;include&gt;&gt;\nUC_CapMa .&gt; UC_ThuLePhi : &lt;&lt;include&gt;&gt;\nUC_InBia .&gt; UC_CapMa : &lt;&lt;include&gt;&gt;\n\nUC_DatLich .&gt; UC_KiemTraLePhi : &lt;&lt;include&gt;&gt;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Cx3N7AUUuRrsf5kUoTOt-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
