        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml ERD_QuanLyHoSoBenhAn\ntitle SƠ ĐỒ THỰC THỂ MỐI QUAN HỆ (ERD) - QUẢN LÝ HỒ SƠ BỆNH ÁN BỆNH NHÂN\n\nentity \&quot;BenhNhan\&quot; as BenhNhan {\n    * MaBenhNhan : PK\n    --\n    HoTen\n    NgaySinh\n    DiaChi\n    SoDienThoai\n}\n\nentity \&quot;HoSoBenhAn\&quot; as HoSoBenhAn {\n    * MaHoSo : PK\n    --\n    MaBenhNhan : FK\n    NgayLap\n    NgayHetHanLePhi\n}\n\nentity \&quot;LePhiNam\&quot; as LePhiNam {\n    * MaLePhi : PK\n    --\n    MaHoSo : FK\n    Nam\n    SoTien\n}\n\nentity \&quot;LichHenKham\&quot; as LichHenKham {\n    * MaLichHen : PK\n    --\n    MaHoSo : FK\n    NgayGioHen\n    Quy\n    Nam\n}\n\nentity \&quot;BacSi\&quot; as BacSi {\n    * MaBacSi : PK\n    --\n    HoTen\n    SoDienThoai\n    ChuyenKhoa\n}\n\nentity \&quot;KhoaDieuTri\&quot; as KhoaDieuTri {\n    * MaKhoa : PK\n    --\n    TenKhoa\n    ViTri\n}\n\nentity \&quot;PhieuKhamBenh\&quot; as PhieuKhamBenh {\n    * MaPhieuKham : PK\n    --\n    MaHoSo : FK\n    MaBacSi : FK\n    MaKhoa : FK\n    NgayGioKham\n    LoaiKham\n    TrieuChung\n    KetLuanBenh\n}\n\nentity \&quot;XetNhiem\&quot; as XetNhiem {\n    * MaXetNhiem : PK\n    --\n    MaPhieuKham : FK\n    TenXetNhiem\n    KetQua\n}\n\nentity \&quot;ToaThuoc\&quot; as ToaThuoc {\n    * MaToa : PK\n    --\n    MaPhieuKham : FK\n    NgayLap\n    GhiChu\n}\n\nentity \&quot;ChiTietToaThuoc\&quot; as ChiTietToaThuoc {\n    * MaToa : PK, FK\n    * MaThuoc : PK, FK\n    --\n    SoLuong\n    LieuDung\n    DonGia\n}\n\nentity \&quot;Thuoc\&quot; as Thuoc {\n    * MaThuoc : PK\n    --\n    TenThuoc\n    DonViTinh\n    DonGia\n}\n\nentity \&quot;HoaDonVienPhi\&quot; as HoaDonVienPhi {\n    * MaHoaDon : PK\n    --\n    MaPhieuKham : FK\n    NgayThanhToan\n    TienXetNhiem\n    TienThuoc\n    TienKham\n    TongTien\n}\n\n&#39; ==========================================\n&#39; MỐI QUAN HỆ VÀ BẢN SỐ (CẤU TRÚC THEO SƠ ĐỒ)\n&#39; ==========================================\n\nBenhNhan ||--|| HoSoBenhAn : \&quot;sở hữu\&quot;\nHoSoBenhAn ||--o{ LePhiNam : \&quot;thu đóng\&quot;\nHoSoBenhAn ||--o{ LichHenKham : \&quot;đặt lịch\&quot;\nHoSoBenhAn ||--o{ PhieuKhamBenh : \&quot;chứa các đợt khám\&quot;\n\nBacSi ||--o{ PhieuKhamBenh : \&quot;thực hiện khám\&quot;\nKhoaDieuTri ||--o{ PhieuKhamBenh : \&quot;tiếp nhận khám\&quot;\n\nPhieuKhamBenh ||--o{ XetNhiem : \&quot;chỉ định\&quot;\nPhieuKhamBenh ||--|| ToaThuoc : \&quot;kê đơn\&quot;\nPhieuKhamBenh ||--|| HoaDonVienPhi : \&quot;thanh toán\&quot;\n\nToaThuoc ||--|{ ChiTietToaThuoc : \&quot;bao gồm\&quot;\nThuoc ||--o{ ChiTietToaThuoc : \&quot;xuất hiện trong\&quot;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5g07RuqhbW1kX_CrKUid-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="SƠ ĐỒ THỰC THỂ MỐI QUAN HỆ (ERD) - QUẢN LÝ HỒ SƠ BỆNH ÁN BỆNH NHÂN" plantUmlId="cltitle_2" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="SƠ ĐỒ THỰC THỂ MỐI QUAN HỆ (ERD) - QUẢN LÝ HỒ SƠ BỆNH ÁN BỆNH NHÂN" id="5g07RuqhbW1kX_CrKUid-2">
