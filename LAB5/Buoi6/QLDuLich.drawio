        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nactor \&quot;NV Kinh doanh\&quot; as NVKD\nparticipant \&quot;:FrmDangKyDoan\&quot; as UI\nparticipant \&quot;:DangKyDoanService\&quot; as Service\nparticipant \&quot;:DangKyDoan\&quot; as DK\nparticipant \&quot;:PhanCongHDV\&quot; as PC\n\nNVKD -&gt; UI : Chọn phiếu đoàn &amp; Nhấn \&quot;Hủy phiếu\&quot;\nUI -&gt; Service : HuyDangKy(soDKDoan)\n\nService -&gt; DK : LayThongTin(soDKDoan)\nDK --&gt; Service : TrangThai, NgayDi\n\nalt TrangThai != \&quot;Đã đăng ký\&quot; OR NgayDi &lt;= Today\n    Service --&gt; UI : KetQuaXuLy.Fail(\&quot;Không thể hủy phiếu này\&quot;)\n    UI --&gt; NVKD : Hiển thị thông báo lỗi\nelse Hợp lệ (Cho phép hủy)\n    note over Service, PC : Thực hiện trong 1 Transaction\n    Service -&gt; PC : DeleteBySoDKDoan(soDKDoan)\n    PC --&gt; Service : Đã gỡ phân công HDV\n    \n    Service -&gt; DK : UpdateTrangThai(soDKDoan, \&quot;Hủy - mất cọc\&quot;)\n    DK --&gt; Service : Đã cập nhật\n    \n    Service --&gt; UI : KetQuaXuLy.Ok(\&quot;Hủy thành công, đoàn mất cọc\&quot;)\n    UI --&gt; NVKD : Thông báo kết quả &amp; Nạp lại dữ liệu\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="RI29YYJGulDp3BzYRr8X-184">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
