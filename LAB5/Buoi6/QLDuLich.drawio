        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nstart\n:NV Kinh doanh nhập thông tin đoàn khách &amp; đăng ký;\n\nif (Số người &gt; 12?) then (Không)\n    :Báo lỗi \&quot;Số người đoàn phải lớn hơn 12\&quot;;\n    stop\nelse (Có)\nendif\n\nif (Tiền cọc &gt; 0?) then (Không)\n    :Báo lỗi \&quot;Đoàn phải đặt cọc trước\&quot;;\n    stop\nelse (Có)\nendif\n\nif (Đoàn có mua bảo hiểm?) then (Có)\n    :Nhập danh sách người cùng đi;\n    if (Số lượng người đi == Số người đăng ký?) then (Sai)\n        :Báo lỗi \&quot;Danh sách người đi không đủ số lượng\&quot;;\n        stop\n    else (Đúng)\n    endif\nelse (Không)\nendif\n\n:Tính Ngày kết thúc = NgayDi + SoNgay - 1;\n:Tính Tổng tiền dự kiến = DonGia * SoNguoi;\n\npartition \&quot;Mở Transaction\&quot; {\n    :Lưu/Cập nhật thông tin DoanKhach;\n    :Tạo phiếu DangKyDoan (Trạng thái: Đã đăng ký);\n    if (Mua bảo hiểm?) then (Có)\n        :Lưu danh sách ThanhVienDoan;\n    endif\n    :Commit Transaction;\n}\n\n:Thông báo Lập phiếu đoàn thành công;\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="RI29YYJGulDp3BzYRr8X-72">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10 710 10 10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlId="start_0" plantUmlBaseStyle="ellipse;fillColor=#222222;strokeColor=#222222;" plantUmlBaseValue="" id="RI29YYJGulDp3BzYRr8X-73">
