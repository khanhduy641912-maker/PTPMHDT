        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nactor \&quot;NV Điều hành\&quot; as NVNV\nparticipant \&quot;:FrmChuyenLe\&quot; as UI\nparticipant \&quot;:ChuyenLeService\&quot; as Service\nparticipant \&quot;:Tour\&quot; as Tour\nparticipant \&quot;:ChuyenLe\&quot; as Chuyen\n\nNVNV -&gt; UI : Chọn Tour, nhập Ngày đi, Địa điểm đón &amp; Nhấn \&quot;Tạo chuyến\&quot;\nUI -&gt; Service : ThemChuyen(maChuyen, maTour, ngayDi, diaDiemDon)\n\nService -&gt; Tour : LaySoNgay(maTour)\nTour --&gt; Service : soNgay (hoặc null nếu dừng bán)\n\nalt Tour không tồn tại / Ngưng mở bán\n    Service --&gt; UI : KetQuaXuLy.Fail(\&quot;Tour không tồn tại hoặc chưa mở bán\&quot;)\n    UI --&gt; NVNV : Hiển thị thông báo lỗi\nelse Tour hợp lệ\n    Service -&gt; Service : Tính ngayVe = ngayDi + soNgay - 1\n    Service -&gt; Chuyen : Insert(maChuyen, maTour, ngayDi, ngayVe, diaDiemDon, \&quot;Mở đăng ký\&quot;)\n    Chuyen --&gt; Service : OK\n    \n    Service --&gt; UI : KetQuaXuLy.Ok(\&quot;Tạo chuyến thành công\&quot;)\n    UI --&gt; NVNV : Thông báo kết quả &amp; Nạp lại danh sách chuyến\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="RI29YYJGulDp3BzYRr8X-210">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
